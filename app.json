{
	"expo": {
		"name": "Unti-Unti",
		"slug": "Unti-Unti",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "unti-unti",
		"userInterfaceStyle": "automatic",
		"ios": {
			"icon": "./assets/expo.icon",
			"bundleIdentifier": "com.jugo.untiunti"
		},
		"android": {
			"userInterfaceStyle": "automatic",
			"softwareKeyboardLayoutMode": "pan",
			"package": "com.jugo.untiunti",
			"adaptiveIcon": {
				"backgroundColor": "#E6F4FE",
				"foregroundImage": "./assets/images/android-icon-foreground.png"
			},
			"predictiveBackGestureEnabled": false
		},
		"web": {
			"output": "single"
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"backgroundColor": "#FDFBF7",
					"image": "./assets/images/splash-icon.png",
					"imageWidth": 720
				}
			],
			"expo-font",
			"expo-image",
			"expo-web-browser",
			"expo-asset",
			"expo-notifications"
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": false
		},
		"updates": {
			"url": "https://u.expo.dev/853c6537-b0aa-42ea-89ae-7c44ae98ee26",
			"enabled": true,
			"fallbackToCacheTimeout": 30000
		},
		"runtimeVersion": {
			"policy": "appVersion"
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "853c6537-b0aa-42ea-89ae-7c44ae98ee26"
			}
		},
		"owner": "ju_go"
	}
}
